<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@drawable/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_background"
        android:padding="12dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/moneyelite"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingBottom="12dp"
            android:text="payment"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#FDD500"/>

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="price : ฿100,000"
            android:textSize="24sp"
            android:paddingBottom="16dp"
            android:layout_gravity="center"
            android:textColor="#FDD500"/>

    </LinearLayout>

    <RadioGroup
        android:id="@+id/radioGroupPaymentMethods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <RadioButton
            android:id="@+id/radioBankTransfer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="โอนผ่านธนาคาร"
            android:textSize="14sp"/>

        <RadioButton
            android:id="@+id/radioQRCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="สแกน QR Code"
            android:textSize="14sp"/>
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_backgroundall"
        android:padding="12dp"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_backgroundedittextall"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/tv_bank1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ธนาคาร 1: ธนาคารกรุงเทพ"
                android:textSize="14sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tv_account1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="เลขที่บัญชี: 123-456-7890"
                android:textSize="12sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_backgroundedittextall"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/tv_bank2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ธนาคาร 2: ธนาคารไทยพาณิชย์"
                android:textSize="14sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tv_account2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="เลขที่บัญชี: 987-654-3210"
                android:textSize="12sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_backgroundedittextall"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/tv_bank3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ธนาคาร 3: ธนาคารกสิกรไทย"
                android:textSize="14sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tv_account3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="เลขที่บัญชี: 112-233-4455"
                android:textSize="12sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/qr"
            android:visibility="gone"
            android:layout_gravity="center"/>

        <Button
            android:id="@+id/btn_confirm_payment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONFIRM PAYMENT"
            android:textSize="14sp"
            android:layout_marginBottom="30dp"/>
    </LinearLayout>

</LinearLayout>
